# Locally cached card images (and deck covers). Moved under static/ in UI plan
# Phase 4 so Streamlit can serve them; the old root path is listed until
# scripts/move_image_cache.py has moved an existing cache over.
/static/image_cache/
/image_cache/

# Python bytecode caches
__pycache__/
.pytest_cache/

# App/debug log (dashboard_lib/log.py) — rotating local log file, not
# meant to be versioned.
/logs/

# SQLite databases — these churn on every run (card data refreshes,
# combo checks, collection edits) and aren't meant to be versioned.
# mtg_collection.db is rebuilt from scratch via migrate.py + your CSVs;
# _test_mtg_collection.db is the offline test harnesses' scratch copy.
*.db
# SQLite side files (rollback journal / WAL) — transient while the app writes.
*.db-journal
*.db-wal
*.db-shm

# Editor settings
.vscode/


# Local secrets (API keys) — never commit
.streamlit/secrets.toml

# Generated Moxfield CSV/text exports (Decks/Collection pages, export scripts)
/moxfield_exports/

# Claude Code per-machine settings
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
